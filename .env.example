# Copy to .env. Most values come from Terraform outputs (`rag tf-outputs`); set here only to override.
AWS_PROFILE=default
RAG_REGION=ap-southeast-2

# Claude model / inference profile. List what's available in your Region with `uv run rag models`.
# GENERATION_MODEL_ID=au.anthropic.claude-sonnet-4-5-20250929-v1:0
# JUDGE_MODEL_ID=

# Retrieval
# TOP_K=5
# AGENT_RETRIEVER=kb   # kb | diy  - which index the local agent's search tool uses
